---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate } from "../lib/format";
import SampleBadge from "./SampleBadge.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  place: string;
  author: string;
  /** Extra mono detail, for example "Serves 4 · 55 min". */
  detail?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  sample?: boolean;
  headingLevel?: "h2" | "h3";
}

const {
  href,
  title,
  description,
  date,
  place,
  author,
  detail,
  cover,
  coverAlt = "",
  sample = false,
  headingLevel: Heading = "h3",
} = Astro.props;
---

<article class="entry-card">
  {cover && <Image class="entry-card__cover" src={cover} alt={coverAlt} widths={[360, 720]} sizes="(width >= 64em) 22rem, 100vw" />}
  <div class="entry-card__body">
    <p class="entry-card__place marker">{place}</p>
    <Heading class="entry-card__title">
      <a href={href}>{title}</a>
    </Heading>
    <p class="entry-card__description">{description}</p>
    <p class="entry-card__meta">
      <span>{author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      {
        detail && (
          <>
            <span aria-hidden="true">·</span>
            <span>{detail}</span>
          </>
        )
      }
    </p>
    {sample && <SampleBadge />}
  </div>
</article>

<style>
  .entry-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-top: 2px solid var(--color-ink);
  }

  .entry-card__cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .entry-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-block: 0.875rem 0.5rem;
  }

  .entry-card__title {
    font-size: var(--step-2);
  }

  .entry-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .entry-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .entry-card:hover .entry-card__title a {
    color: var(--color-sea);
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }

  .entry-card:has(:focus-visible) {
    outline: 3px solid var(--color-thrift);
    outline-offset: 4px;
  }

  .entry-card__title a:focus-visible {
    outline: none;
  }

  .entry-card__description {
    color: var(--color-ink-soft);
  }

  .entry-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }
</style>
