---
import { formatDate } from "../lib/format";

interface Props {
  authorId: string;
  authorName: string;
  date: Date;
  extra?: string;
}

const { authorId, authorName, date, extra } = Astro.props;
---

<p class="byline">
  <span>By <a href={`/family/${authorId}/`}>{authorName}</a></span>
  <span aria-hidden="true">·</span>
  <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
  {
    extra && (
      <>
        <span aria-hidden="true">·</span>
        <span>{extra}</span>
      </>
    )
  }
</p>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
  }
</style>
