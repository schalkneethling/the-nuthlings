---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  animal: CollectionEntry<"animals">;
}

const { animal } = Astro.props;
const { name, kind, description, photo, photoAlt = "" } = animal.data;
---

<article class="animal">
  {photo ? <Image class="animal__photo" src={photo} alt={photoAlt} widths={[240, 480]} sizes="15rem" /> : <div class="animal__placeholder" aria-hidden="true" />}
  <p class="marker">{kind}</p>
  <h3 class="animal__name">{name}</h3>
  <p class="animal__description">{description}</p>
</article>

<style>
  .animal {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .animal__photo,
  .animal__placeholder {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 0.5rem;
  }

  /* Without a photo, a pebble-colored circle holds the space. */
  .animal__placeholder {
    background:
      radial-gradient(circle at 35% 30%, var(--color-surface) 0 18%, transparent 19%),
      var(--color-surface-strong);
  }

  .animal__name {
    font-size: var(--step-2);
  }

  .animal__description {
    color: var(--color-ink-soft);
  }
</style>
